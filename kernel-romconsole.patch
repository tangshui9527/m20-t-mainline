-	bne	1002f
+@	tst	\rd, #0x08
+@	bne	1002f
 	@ wait for TXREADY in UARTDM_ISR
-1001:	ldr	\rd, [\rx, #0x14]
+@1001:	ldr	\rd, [\rx, #0x14]
 ARM_BE8(rev     \rd, \rd )
-	tst	\rd, #0x80
-	beq 	1001b
-1002:
+@	tst	\rd, #0x80
+@	beq 	1001b
+@1002:
 	@ Clear TX_READY by writing to the UARTDM_CR register
-	mov	\rd, #0x300
