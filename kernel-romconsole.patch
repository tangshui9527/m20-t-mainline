 	.macro	waituarttxrdy, rd, rx
+	@ M20-T DEBUG_LL RAM console: the "UART" is a RAM buffer
+	@ (DEBUG_UART_PHYS=0x8f001000); polling status bits in RAM
+	@ garbage would spin forever. No waiting needed - just store.
 	@ check for TX_EMT in UARTDM_SR
-	ldr	\rd, [\rx, #0x08]
+@	ldr	\rd, [\rx, #0x08]
 ARM_BE8(rev     \rd, \rd )
