--- a/arch/arm/boot/compressed/misc.c
+++ b/arch/arm/boot/compressed/misc.c
@@ -132,6 +132,9 @@ void
 decompress_kernel(unsigned long output_start, unsigned long free_mem_ptr_p,
 		unsigned long free_mem_ptr_end_p,
 		int arch_id)
 {
 	int ret;
 
+	/* M20-T early-hang bisection: pre-MMU direct PA store (no console yet) */
+	*(volatile unsigned char *)0x8f000000 = 0xA1;
+
 	output_data		= (unsigned char *)output_start;
 	free_mem_ptr		= free_mem_ptr_p;
 	free_mem_end_ptr	= free_mem_ptr_end_p;
@@ -152,6 +155,9 @@ decompress_kernel(unsigned long output_start, unsigned long free_mem_ptr_p,
 	if (ret)
 		error("decompressor returned an error");
 	else
 		putstr(" done, booting the kernel.\n");
+
+	*(volatile unsigned char *)0x8f000001 = 0xA2;
 }
--- a/init/main.c
+++ b/init/main.c
@@ -1008,6 +1008,9 @@ asmlinkage __visible void __init __no_sanitize_address start_kernel(void)
 	char *command_line;
 	char *after_dashes;
 
+	/* M20-T early-hang bisection: through head.S-mapped debug window
+	 * (CONFIG_DEBUG_UART_VIRT 0xcf001000 = phys 0x8f001000) */
+	*(volatile unsigned char *)0xcf001000 = 0xA5;
+
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
